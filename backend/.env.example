# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Core secrets (REQUIRED) ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Generate: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# --- Seed admin account (REQUIRED — used once by seed.py to create the first login) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running-seed

# --- Database ---
DATABASE_URL=sqlite:///./workbench.db

# --- Git / GitHub ---
# The repo interns branch from and PR back into, e.g.:
# UPSTREAM_REPO_URL=https://github.com/Gayatri-Education/Gayatri-AI.git
# For local testing without real GitHub, point this at a local bare repo instead, e.g.:
# UPSTREAM_REPO_URL=file:///home/you/dummy-upstream.git
UPSTREAM_REPO_URL=
GITHUB_REPO_OWNER=Gayatri-Education
GITHUB_REPO_NAME=Gayatri-AI
BASE_BRANCH=main
# Service-account PAT, repo-scoped with contents + pull-requests write access.
# Leave blank for local testing against a file:// remote (push works without it;
# opening a real GitHub PR will fail with a clear error until this is set).
GITHUB_TOKEN=

# Where the bare mirror clone and per-intern worktrees live on disk. Relative
# paths (the default) resolve under the backend/ directory and need no special
# permissions, which is usually fine on EC2 too. Use an absolute path like
# /srv/workbench/... if you want this data to live outside the app checkout.
GIT_ROOT=./data/repo-mirror.git
WORKSPACES_ROOT=./data/workspaces

# --- OpenRouter ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- App / networking ---
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
PR_POLL_INTERVAL_SECONDS=120
# Only used if you build the frontend and want the backend to serve it directly
# instead of nginx (see README "single-process local test").
FRONTEND_DIST_DIR=../frontend/dist
